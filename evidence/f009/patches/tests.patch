+	actool "github.com/Autumn-27/norma/tool"
+	"github.com/Autumn-27/norma/transcript"
+)
+
+type runInfoProvider struct{ calls int }
+
+func (p *runInfoProvider) Complete(context.Context, llm.CompletionRequest) (llm.Message, string, llm.Usage, error) {
+	p.calls++
+	if p.calls == 1 {
+		return llm.Message{Role: llm.RoleAssistant, Content: []llm.ContentBlock{{
+			Type: llm.BlockToolUse, ID: "scope-probe", Name: "scope_probe", Input: json.RawMessage(`{}`),
+		}}}, "tool_use", llm.Usage{}, nil
+	}
+	return llm.Message{Role: llm.RoleAssistant, Content: []llm.ContentBlock{llm.TextBlock("done")}}, "end_turn", llm.Usage{}, nil
+}
+
+func (p *runInfoProvider) Stream(ctx context.Context, req llm.CompletionRequest) iter.Seq2[llm.StreamEvent, error] {
+	return func(y func(llm.StreamEvent, error) bool) {
+		msg, stop, _, err := p.Complete(ctx, req)
+		if err != nil {
+			y(llm.StreamEvent{}, err)
+			return
+		}
+		for _, b := range msg.Content {
+			if b.Type == llm.BlockToolUse {
+				if !y(llm.StreamEvent{Type: llm.SEToolUseStart, ToolID: b.ID, ToolName: b.Name}, nil) ||
+					!y(llm.StreamEvent{Type: llm.SEToolInputJSON, Text: string(b.Input)}, nil) {
+					return
+				}
+			} else if !y(llm.StreamEvent{Type: llm.SETextDelta, Text: b.Text}, nil) {
+				return
+			}
+		}
+		y(llm.StreamEvent{Type: llm.SEMessageDelta, StopReason: stop}, nil)
+		y(llm.StreamEvent{Type: llm.SEMessageStop}, nil)
+	}
+}
+
+type runInfoProbe struct{ got RunInfo }
+
+func (p *runInfoProbe) tool() actool.CoreTool {
+	return actool.Build(actool.Spec{
+		Name:        "scope_probe",
+		Description: "records the run context",
+		Schema:      map[string]any{"type": "object", "properties": map[string]any{}},
+		Permissions: func(context.Context, json.RawMessage, permission.Context) permission.Decision {
+			return permission.Allowed()
+		},
+		Run: func(ctx context.Context, _ json.RawMessage, _ *actool.ToolContext) (actool.Result, error) {
+			p.got = RunInfoFrom(ctx)
+			return actool.Text("ok"), nil
+		},
+	})
+}
+
+func TestChatRunInfoCarriesTriggerTaskID(t *testing.T) {
+	probe := &runInfoProbe{}
+	old := ToolAugment
+	ToolAugment = func(context.Context, string) ([]actool.CoreTool, DeferredInfo, func()) {
+		return []actool.CoreTool{probe.tool()}, DeferredInfo{}, func() {}
+	}
+	defer func() { ToolAugment = old }()
+
+	chat := NewChatAgent(&runInfoProvider{}, "fixture", t.TempDir(), transcript.NewStore(t.TempDir()), 1000)
+	chat.SetNonStreaming(func() bool { return true })
+	_, err := chat.Chat(context.Background(), "reporter", "conv-scope", "call the probe", 42, 2, time.Minute, false, func(db.Activity) {})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if probe.got.TaskID != 42 || probe.got.SessionID != "conv-scope" {
+		t.Fatalf("Chat run info = %+v, want task 42 and conv-scope", probe.got)
+	}
+}
