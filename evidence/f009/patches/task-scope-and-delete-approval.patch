+// wrAskTool is the approval-gated variant of wrTool for irreversible host
+// actions. The permission decision must stay Ask even after the host tool is
+// decorated/bound, so the operator sees the action before it executes.
+func wrAskTool(name, desc string, schema map[string]any, message string, run func(context.Context, json.RawMessage) (actool.Result, error)) actool.CoreTool {
+	return actool.Build(actool.Spec{
+		Name: name, Description: desc, Schema: schema,
+		Permissions: func(context.Context, json.RawMessage, permission.Context) permission.Decision {
+			return permission.AskUser(message)
+		},
+		Run: func(ctx context.Context, in json.RawMessage, _ *actool.ToolContext) (actool.Result, error) {
+			return run(ctx, in)
+		},
+	})
+}
