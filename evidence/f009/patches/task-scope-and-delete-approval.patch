+// FindingTaskIDByNodeID returns the task that owns a finding node. A finding
+// whose task was deleted has NULL task_id and reports 0; callers that enforce a
+// run's task scope must treat that as not owned.
+func (d *DB) FindingTaskIDByNodeID(nodeID int64) (taskID int64, err error) {
+	err = d.QueryRow(`SELECT COALESCE(task_id,0) FROM findings WHERE node_id=$1`, nodeID).Scan(&taskID)
+	if errors.Is(err, sql.ErrNoRows) {
+		return 0, nil
+	}
+	return
+}
