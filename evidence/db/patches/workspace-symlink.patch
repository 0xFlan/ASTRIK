+// pathCrossesSymlink reports whether any existing component of abs below root is a
+// symlink. A missing component ends the walk: nothing below it exists yet, and
+// MkdirAll/WriteFile create regular entries there. The root itself may be a symlink
+// (macOS /var → /private/var); only components below it are inspected.
+func pathCrossesSymlink(root, abs string) bool {
+	rel, err := filepath.Rel(root, abs)
+	if err != nil {
+		return true
+	}
+	current := root
+	for _, part := range strings.Split(rel, string(os.PathSeparator)) {
+		if part == "" || part == "." {
+			continue
+		}
+		current = filepath.Join(current, part)
+		info, err := os.Lstat(current)
+		if os.IsNotExist(err) {
+			return false
+		}
+		if err != nil {
+			return true
+		}
+		if info.Mode()&os.ModeSymlink != 0 {
+			return true
+		}
+	}
+	return false
+}
