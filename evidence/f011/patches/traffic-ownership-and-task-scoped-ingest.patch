+// TrafficTokenTask resolves a task-scoped traffic bearer. It is used by the
+// proxy auth hook and the ingest route; read APIs never accept it.
+func (m *Manager) TrafficTokenTask(token string) (int64, bool) {
+	if m.pg == nil || strings.TrimSpace(token) == "" {
+		return 0, false
+	}
+	return m.pg.ResolveTaskTrafficToken(strings.TrimSpace(token))
+}
+
+// ProxyAddrForTask returns the recording-proxy URL with the task token in the
+// userinfo. The proxy consumes Proxy-Authorization and stamps every captured
+// exchange with this task; the token is never forwarded to the target.
+func (m *Manager) ProxyAddrForTask(taskID int64) string {
+	base := m.ProxyAddr()
+	if taskID <= 0 || m.pg == nil || m.traffic == nil || !m.TrafficEnabled() {
+		return base
+	}
+	token, err := m.pg.EnsureTaskTrafficToken(taskID)
+	if err != nil {
+		log.Printf("[traffic] task %d token unavailable: %v", taskID, err)
+		return base
+	}
+	u, err := url.Parse(base)
+	if err != nil || u.Host == "" {
+		return base
+	}
+	u.User = url.UserPassword(strconv.FormatInt(taskID, 10), token)
+	return u.String()
 }
 
 func (m *Manager) Assets() *pgdb.AssetStore  { return m.assets }
