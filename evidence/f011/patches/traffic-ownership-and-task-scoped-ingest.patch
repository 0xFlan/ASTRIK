new file mode 100644
index 0000000..b2e210f
--- /dev/null
+++ b/traffic/owner.go
@@ -0,0 +1,93 @@
+package traffic
+
+import (
+	"encoding/base64"
+	"errors"
+	"net/http"
+	"strings"
+
+	mproxy "github.com/lqqyt2423/go-mitmproxy/proxy"
+)
+
+// SetTokenResolver installs the host-owned mapping from a task-scoped traffic
+// bearer token to its task id. It is intentionally installed after Open: the
+// traffic package has no PostgreSQL dependency and must keep working for
+// operator-only captures.
+func (t *Traffic) SetTokenResolver(fn func(string) (int64, bool)) {
+	t.ownerMu.Lock()
+	t.tokenResolver = fn
+	t.ownerMu.Unlock()
+}
+
+// authProxy is go-mitmproxy's proxy-authentication hook. A request without
+// credentials stays anonymous (task 0, operator view). A request with a token
+// must resolve to a live task; its client connection is remembered so every
+// exchange on that connection is stamped with the same owner. The token is
+// consumed here and never added to the captured request.
+func (t *Traffic) authProxy(_ http.ResponseWriter, req *http.Request) (bool, error) {
+	token := proxyBearer(req)
+	if token == "" {
+		return true, nil
+	}
+	t.ownerMu.RLock()
+	resolver := t.tokenResolver
+	t.ownerMu.RUnlock()
+	if resolver == nil {
+		return false, errors.New("traffic token presented but token resolution is not configured")
+	}
+	taskID, ok := resolver(token)
+	if !ok || taskID <= 0 {
+		return false, errors.New("invalid traffic token")
+	}
+	if addr := clientAddr(req); addr != "" {
+		t.ownerMu.Lock()
+		t.connOwners[addr] = taskID
+		t.ownerMu.Unlock()
+	}
+	return true, nil
+}
+
+// proxyBearer extracts the password from a Basic Proxy-Authorization header.
+// Proxy URLs built as http://task:<token>@host:port produce exactly that shape.
+func proxyBearer(req *http.Request) string {
+	raw := strings.TrimSpace(req.Header.Get("Proxy-Authorization"))
+	if raw == "" {
+		return ""
+	}
+	const basic = "basic "
+	if len(raw) < len(basic) || !strings.EqualFold(raw[:len(basic)], basic) {
+		return ""
+	}
+	decoded, err := base64.StdEncoding.DecodeString(strings.TrimSpace(raw[len(basic):]))
+	if err != nil {
+		return ""
+	}
+	_, token, ok := strings.Cut(string(decoded), ":")
+	if !ok {
+		return ""
+	}
+	return strings.TrimSpace(token)
+}
+
+func clientAddr(req *http.Request) string {
+	if req == nil {
+		return ""
+	}
+	return strings.TrimSpace(req.RemoteAddr)
+}
+
+// ownerForFlow reads the task stamped on the client connection by authProxy.
+// A missing or anonymous connection is owner 0: operator-only traffic, never
+// readable by a task-scoped agent.
+func (t *Traffic) ownerForFlow(f *mproxy.Flow) int64 {
+	if f == nil || f.ConnContext == nil || f.ConnContext.ClientConn == nil || f.ConnContext.ClientConn.Conn == nil {
+		return 0
+	}
+	addr := strings.TrimSpace(f.ConnContext.ClientConn.Conn.RemoteAddr().String())
+	if addr == "" {
+		return 0
+	}
+	t.ownerMu.RLock()
+	defer t.ownerMu.RUnlock()
+	return t.connOwners[addr]
+}
