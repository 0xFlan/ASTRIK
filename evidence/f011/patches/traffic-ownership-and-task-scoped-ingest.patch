+-- Per-task bearer tokens for traffic capture/ingest. The raw token is returned
+-- to the task's own agent as proxy credentials and to the ingest client; it is
+-- never accepted for read APIs. A token is scoped to one task and cascades when
+-- the task is deleted.
+CREATE TABLE IF NOT EXISTS task_traffic_tokens (
+    task_id    BIGINT PRIMARY KEY REFERENCES tasks(id) ON DELETE CASCADE,
+    token      TEXT NOT NULL UNIQUE,
+    created_at TIMESTAMPTZ NOT NULL DEFAULT now()
+);
 -- planner heartbeat trigger interval (seconds); backfills old databases. Default 300s (5min). See docs/planner-trigger-impl-plan.md
 ALTER TABLE tasks ADD COLUMN IF NOT EXISTS plan_heartbeat_seconds INTEGER NOT NULL DEFAULT 300;
 ALTER TABLE tasks ADD COLUMN IF NOT EXISTS plan_quiet_mode BOOLEAN NOT NULL DEFAULT true;
diff --git a/db/task_traffic_tokens.go b/db/task_traffic_tokens.go
new file mode 100644
index 0000000..3084f93
--- /dev/null
+++ b/db/task_traffic_tokens.go
@@ -0,0 +1,61 @@
+package db
+
+import (
+	"crypto/rand"
+	"database/sql"
+	"encoding/base64"
+	"errors"
+	"fmt"
+)
+
+const taskTrafficTokenPrefix = "astk_"
+
+// EnsureTaskTrafficToken returns the stable capture/ingest bearer token for a
+// task, creating one on first use. The token is deliberately stored verbatim:
+// the owning task's agent must be able to present it as proxy credentials and
+// the browser extension must be able to present it to the ingest route. It is
+// only accepted by those two paths, never by a traffic read API.
+func (d *DB) EnsureTaskTrafficToken(taskID int64) (string, error) {
+	if taskID <= 0 {
+		return "", errors.New("task id must be positive")
+	}
+	var token string
+	err := d.QueryRow(`SELECT token FROM task_traffic_tokens WHERE task_id=$1`, taskID).Scan(&token)
+	if err == nil {
+		return token, nil
+	}
+	if !errors.Is(err, sql.ErrNoRows) {
+		return "", err
+	}
+	buf := make([]byte, 32)
+	if _, err := rand.Read(buf); err != nil {
+		return "", fmt.Errorf("generate task traffic token: %w", err)
+	}
+	token = taskTrafficTokenPrefix + base64.RawURLEncoding.EncodeToString(buf)
+	if _, err := d.Exec(`INSERT INTO task_traffic_tokens(task_id,token) VALUES($1,$2) ON CONFLICT (task_id) DO NOTHING`, taskID, token); err != nil {
+		return "", err
+	}
+	// Another process may have won the insert race; re-read so every caller
+	// receives the token actually persisted.
+	if err := d.QueryRow(`SELECT token FROM task_traffic_tokens WHERE task_id=$1`, taskID).Scan(&token); err != nil {
+		return "", err
+	}
+	return token, nil
+}
+
+// ResolveTaskTrafficToken maps a bearer token to its live task. Deleted tasks
+// are excluded; their token rows cascade, but the join also makes archival or
+// soft-delete behavior explicit.
+func (d *DB) ResolveTaskTrafficToken(token string) (int64, bool) {
+	if len(token) < len(taskTrafficTokenPrefix) || token[:len(taskTrafficTokenPrefix)] != taskTrafficTokenPrefix {
+		return 0, false
+	}
+	var taskID int64
+	err := d.QueryRow(`SELECT tt.task_id FROM task_traffic_tokens tt
+JOIN tasks t ON t.id=tt.task_id AND t.deleted_at IS NULL
+WHERE tt.token=$1`, token).Scan(&taskID)
+	if err != nil || taskID <= 0 {
+		return 0, false
+	}
+	return taskID, true
+}
