@@ -0,0 +1,32 @@
+package traffic
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRedactHTTPRemovesCredentialHeadersAndBodySecrets(t *testing.T) {
+	raw := "GET /account HTTP/1.1\nHost: example.test\nAuthorization: Bearer TASK_A_SECRET\nCookie: sid=COOKIE_SECRET\n\n" +
+		`{"account":"a","password":"PASSWORD_SECRET","token":"BODY_TOKEN","ok":true}`
+	out := redactHTTP(raw)
+	for _, secret := range []string{"TASK_A_SECRET", "COOKIE_SECRET", "PASSWORD_SECRET", "BODY_TOKEN"} {
+		if strings.Contains(out, secret) {
+			t.Fatalf("redaction left %q in %q", secret, out)
+		}
+	}
+	for _, want := range []string{"Authorization: [redacted]", "Cookie: [redacted]", `"password":"[redacted]"`, `"token":"[redacted]"`, `"ok":true`} {
+		if !strings.Contains(out, want) {
+			t.Fatalf("redaction removed context %q: %q", want, out)
+		}
+	}
+}
+
+func TestRedactHTTPHandlesFormAndBareBearer(t *testing.T) {
+	out := redactHTTP("POST /login HTTP/1.1\n\nuser=a&password=FORM_SECRET&next=%2F  Bearer BARE_SECRET")
+	if strings.Contains(out, "FORM_SECRET") || strings.Contains(out, "BARE_SECRET") {
+		t.Fatalf("form/bearer secret leaked: %q", out)
+	}
+	if !strings.Contains(out, "user=a") || !strings.Contains(out, "password=[redacted]") {
+		t.Fatalf("form context changed: %q", out)
+	}
+}
