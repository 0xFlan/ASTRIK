diff --git a/traffic/redact.go b/traffic/redact.go
new file mode 100644
index 0000000..f2c9100
--- /dev/null
+++ b/traffic/redact.go
@@ -0,0 +1,55 @@
+package traffic
+
+import (
+	"regexp"
+	"strings"
+)
+
+// redactHTTP removes credentials from an agent-facing request/response while
+// leaving the operator's stored capture untouched. Headers are redacted by
+// name; bodies by common secret-bearing JSON/form keys and bearer/JWT shapes.
+func redactHTTP(raw string) string {
+	head, body, sep := splitHTTP(raw)
+	lines := strings.Split(head, "\n")
+	for i, line := range lines {
+		name, _, ok := strings.Cut(line, ":")
+		if !ok || !sensitiveHeader(name) {
+			continue
+		}
+		lines[i] = name + ": [redacted]"
+	}
+	return strings.Join(lines, "\n") + sep + redactBody(body)
+}
+
+func splitHTTP(raw string) (head, body, sep string) {
+	if i := strings.Index(raw, "\r\n\r\n"); i >= 0 {
+		return raw[:i], raw[i+4:], "\r\n\r\n"
+	}
+	if i := strings.Index(raw, "\n\n"); i >= 0 {
+		return raw[:i], raw[i+2:], "\n\n"
+	}
+	return raw, "", ""
+}
+
+func sensitiveHeader(name string) bool {
+	switch strings.ToLower(strings.TrimSpace(name)) {
+	case "authorization", "proxy-authorization", "cookie", "set-cookie", "x-api-key", "api-key", "x-auth-token", "x-amz-security-token", "x-csrf-token", "x-xsrf-token":
+		return true
+	}
+	return false
+}
+
+var (
+	jsonSecret = regexp.MustCompile(`(?i)("(?:password|passwd|pwd|secret|token|access_token|refresh_token|api[_-]?key|apikey|authorization|cookie|session(?:id)?|client[_-]?secret)"\s*:\s*)"(?:[^"\\]|\\.)*"`)
+	formSecret = regexp.MustCompile(`(?i)\b(password|passwd|pwd|secret|token|access_token|refresh_token|api[_-]?key|apikey|authorization|cookie|session(?:id)?)=([^&\s"']+)`)
+	bearer     = regexp.MustCompile(`(?i)\b(Bearer|Basic)\s+[A-Za-z0-9._~+/=-]{8,}`)
+	jwt        = regexp.MustCompile(`\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\b`)
+)
+
+func redactBody(body string) string {
+	body = jsonSecret.ReplaceAllString(body, `${1}"[redacted]"`)
+	body = formSecret.ReplaceAllString(body, `${1}=[redacted]`)
+	body = bearer.ReplaceAllString(body, `${1} [redacted]`)
+	body = jwt.ReplaceAllString(body, `[redacted-jwt]`)
+	return body
+}
diff --git a/traffic/scope.go b/traffic/scope.go
new file mode 100644
index 0000000..cd71bf4
--- /dev/null
+++ b/traffic/scope.go
@@ -0,0 +1,107 @@
+package traffic
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// HostScope resolves the hosts a run is allowed to inspect. scoped=false is the
+// operator/chat path: no task boundary applies. A scoped run with an empty host
+// set can inspect nothing; a lookup failure fails closed.
+type HostScope func(context.Context) (hosts []string, scoped bool, err error)
+
+func hostSet(hosts []string) map[string]struct{} {
+	out := make(map[string]struct{}, len(hosts))
+	for _, raw := range hosts {
+		host, _, err := normalizeSearchHost(raw)
+		if err != nil || host == "" {
+			continue
+		}
+		out[host] = struct{}{}
+	}
+	return out
+}
+
+// hostInScope reports whether host is one of the caller task's assets. The
+// original host may be a bare host, host:port, or a full URL; comparisons use
+// the same canonical hostname the traffic index stores.
+func (t *Traffic) hostInScope(ctx context.Context, scope HostScope, host string) (bool, error) {
+	if scope == nil {
+		return true, nil
+	}
+	hosts, scoped, err := scope(ctx)
+	if err != nil {
+		return false, err
+	}
+	if !scoped {
+		return true, nil
+	}
+	name, _, err := normalizeSearchHost(host)
+	if err != nil {
+		return false, err
+	}
+	_, ok := hostSet(hosts)[name]
+	return ok, nil
+}
+
+func (t *Traffic) exchangeHost(id string) (string, error) {
+	var host string
+	err := t.db.QueryRow(`SELECT host FROM exchanges WHERE id=?`, id).Scan(&host)
+	return host, err
+}
+
+// idInScope resolves an exchange id to its recorded host and applies the same
+// task-asset boundary as a host search. A missing id is not a scope violation;
+// Get reports the normal not-found error.
+func (t *Traffic) idInScope(ctx context.Context, scope HostScope, id string) (bool, error) {
+	if scope == nil {
+		return true, nil
+	}
+	host, err := t.exchangeHost(id)
+	if errors.Is(err, sql.ErrNoRows) {
+		return true, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	return t.hostInScope(ctx, scope, host)
+}
+
+func (t *Traffic) blobInScope(ctx context.Context, scope HostScope, hash string) (bool, error) {
+	if scope == nil {
+		return true, nil
+	}
+	rows, err := t.db.Query(`SELECT DISTINCT e.host FROM blob_refs b JOIN exchanges e ON e.id=b.exchange_id WHERE b.hash=?`, strings.ToLower(strings.TrimSpace(hash)))
+	if err != nil {
+		return false, err
+	}
+	defer rows.Close()
+	var hosts []string
+	for rows.Next() {
+		var host string
+		if err := rows.Scan(&host); err != nil {
+			return false, err
+		}
+		hosts = append(hosts, host)
+	}
+	if err := rows.Err(); err != nil {
+		return false, err
+	}
+	if len(hosts) == 0 {
+		return false, fmt.Errorf("traffic blob %s is not associated with a recorded exchange", hash)
+	}
+	for _, host := range hosts {
+		ok, err := t.hostInScope(ctx, scope, host)
+		if err != nil || !ok {
+			return false, err
+		}
+	}
+	return true, nil
+}
+
+func scopeDenied(host string) string {
+	return fmt.Sprintf("traffic for host %q is outside this run's task assets; use the operator Traffic page for cross-task inspection", host)
+}
