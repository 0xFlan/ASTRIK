+// validateAgentMCPTarget keeps the agent-facing MCP tools away from stdio.
+// connectMCP starts a stdio server with command+args (mcp.NewStdioClient), and
+// startup discovery walks every enabled MCP with an empty cache regardless of
+// visibility. MCP *calls* are AskUser-gated; letting an Allowed agent tool write
+// the launch command would reach the same execution without that gate, so stdio
+// stays an operator-only action (POST /api/mcp, System → MCP).
+func validateAgentMCPTarget(transport, url string) error {
+	switch strings.ToLower(strings.TrimSpace(transport)) {
+	case "http", "sse":
+		if strings.TrimSpace(url) == "" {
+			return fmt.Errorf("%s MCP requires a url", strings.ToLower(strings.TrimSpace(transport)))
+		}
+		return nil
+	case "stdio":
+		return fmt.Errorf("stdio MCP servers launch a local process and are operator-only; add them on the System → MCP page, or use an http/sse transport")
+	default:
+		return fmt.Errorf("transport must be http or sse (stdio is operator-only)")
+	}
+}
