+// restoreRel maps an absolute path under dataDir to a name that os.Root can
+// resolve. A path outside the data dir is refused rather than handed to a second
+// root: extraction and destination must be reached through the same descriptor,
+// so no component is re-resolved between a check and a write.
+func restoreRel(dataDir, abs string) (string, error) {
+	rel, err := filepath.Rel(dataDir, abs)
+	if err != nil {
+		return "", err
+	}
+	if rel == "." || rel == ".." || filepath.IsAbs(rel) ||
+		strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return "", fmt.Errorf("archive restore path escapes the data dir: %s", abs)
+	}
+	return rel, nil
+}
+
+func newRestoredArchivePath(dataDir, source, destination string) (restoredArchivePath, error) {
+	sourceRel, err := restoreRel(dataDir, source)
+	if err != nil {
+		return restoredArchivePath{}, err
+	}
+	destRel, err := restoreRel(dataDir, destination)
+	if err != nil {
+		return restoredArchivePath{}, err
+	}
+	return restoredArchivePath{Source: source, Destination: destination, SourceRel: sourceRel, DestRel: destRel}, nil
+}
+
+// openTaskArchiveRestoreFiles adopts an existing restore journal. The journal
+// keeps absolute paths for backward compatibility; recovery re-derives their
+// root-relative names and refuses a journal whose paths leave dataDir.
+func openTaskArchiveRestoreFiles(dataDir, extractedDir string, moves []restoredArchivePath) (*taskArchiveRestoreFiles, error) {
+	extractedRel, err := restoreRel(dataDir, extractedDir)
+	if err != nil {
+		return nil, err
+	}
+	root, err := os.OpenRoot(dataDir)
+	if err != nil {
+		return nil, err
+	}
+	stage := &taskArchiveRestoreFiles{extracted: extractedDir, extractedRel: extractedRel, root: root, moves: make([]restoredArchivePath, 0, len(moves))}
+	for _, move := range moves {
+		derived, err := newRestoredArchivePath(dataDir, move.Source, move.Destination)
+		if err != nil {
+			_ = root.Close()
+			return nil, err
+		}
+		stage.moves = append(stage.moves, derived)
+	}
+	return stage, nil
+}
