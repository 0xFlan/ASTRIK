+func mcpToolByName(t *testing.T, s *Server, name string) actool.CoreTool {
+	t.Helper()
+	for _, tool := range s.platformTools() {
+		if tool.Name() == name {
+			return tool
+		}
+	}
+	t.Fatalf("platform tool %q not found", name)
+	return nil
+}
+
+func mcpRowByName(t *testing.T, m *Manager, name string) *db.MCPServer {
+	t.Helper()
+	rows, err := m.pg.ListMCP()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, row := range rows {
+		if row.Name == name {
+			return row
+		}
+	}
+	return nil
+}
+
+// An agent-facing MCP write must not be able to install a stdio command. MCP
+// calls are AskUser-gated, but connectMCP starts a stdio server (and startup
+// discovery does so for every enabled cache-empty server), so accepting a stdio
+// command here would reach process execution without that gate.
+func TestAgentMCPToolsRejectStdio(t *testing.T) {
+	m, err := NewManager(t.TempDir(), "")
+	if err != nil {
+		t.Skipf("postgres unavailable (%v) — skipping", err)
+	}
+	defer m.Close()
+	s := New(context.Background(), m, t.TempDir(), t.TempDir(), t.TempDir())
+	create := mcpToolByName(t, s, "create_mcp")
+	update := mcpToolByName(t, s, "update_mcp")
+
+	marker := filepath.Join(t.TempDir(), "stdio-ran")
+	name := "t-f007-stdio"
+	httpName := name + "-http"
+	operatorName := name + "-operator"
+	for _, n := range []string{name, httpName, operatorName} {
+		_, _ = m.pg.Exec(`DELETE FROM mcp_servers WHERE name=$1`, n)
+	}
+	// Registered after defer m.Close, so LIFO runs this while the pool is open.
+	defer func() {
+		for _, n := range []string{name, httpName, operatorName} {
+			_, _ = m.pg.Exec(`DELETE FROM mcp_servers WHERE name=$1`, n)
+		}
+	}()
+	stdlibInput := map[string]any{
+		"name": name, "transport": "stdio", "command": "/bin/sh",
+		"args": []string{"-c", "printf ran > " + marker}, "enabled": true,
+	}
+	raw, _ := json.Marshal(stdlibInput)
+	res, err := create.Call(context.Background(), raw, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !res.IsError {
+		t.Fatalf("agent create_mcp accepted stdio: %s", res.Flatten())
+	}
+	if row := mcpRowByName(t, m, name); row != nil {
+		t.Fatalf("rejected stdio MCP was still persisted: %+v", row)
+	}
+	if _, err := os.Stat(marker); !os.IsNotExist(err) {
+		t.Fatalf("stdio command ran during create: %v", err)
+	}
+
+	// Positive control: the same agent tool still creates an http MCP.
+	httpRaw, _ := json.Marshal(map[string]any{
+		"name": httpName, "transport": "http", "url": "http://127.0.0.1:1/mcp", "enabled": false,
+	})
+	res, err = create.Call(context.Background(), httpRaw, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.IsError {
+		t.Fatalf("agent create_mcp rejected http: %s", res.Flatten())
+	}
+	httpRow := mcpRowByName(t, m, httpName)
+	if httpRow == nil || httpRow.Transport != "http" {
+		t.Fatalf("http MCP row = %+v", httpRow)
+	}
+
+	// Positive control: an existing http MCP is still updatable.
+	updateRaw, _ := json.Marshal(map[string]any{
+		"id": httpRow.ID, "name": httpName, "transport": "http", "url": "http://127.0.0.1:2/mcp", "enabled": false,
+	})
+	res, err = update.Call(context.Background(), updateRaw, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.IsError {
+		t.Fatalf("agent update_mcp rejected http: %s", res.Flatten())
+	}
+
+	// A stdio row remains operator-managed even if the requested new transport is http.
+	stdioID, err := m.pg.SaveMCP(&db.MCPServer{Name: operatorName, Transport: "stdio", Command: "/bin/sh", Enabled: false})
+	if err != nil {
+		t.Fatal(err)
+	}
+	operatorRaw, _ := json.Marshal(map[string]any{
+		"id": stdioID, "name": operatorName, "transport": "http", "url": "http://127.0.0.1:3/mcp", "enabled": false,
+	})
+	res, err = update.Call(context.Background(), operatorRaw, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !res.IsError {
+		t.Fatalf("agent update_mcp rewrote an operator stdio MCP: %s", res.Flatten())
+	}
+}
+
+// The operator path keeps stdio: POST /api/mcp is the explicit UI action.
+func TestOperatorMCPRouteStillAcceptsStdio(t *testing.T) {
+	m, err := NewManager(t.TempDir(), "")
+	if err != nil {
+		t.Skipf("postgres unavailable (%v) — skipping", err)
+	}
+	defer m.Close()
+	s := New(context.Background(), m, t.TempDir(), t.TempDir(), t.TempDir())
+	token, err := signJWT(s.jwtKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	name := "t-f007-operator"
+	_, _ = m.pg.Exec(`DELETE FROM mcp_servers WHERE name=$1`, name)
+	// Registered after defer m.Close, so LIFO runs this while the pool is open.
+	defer func() { _, _ = m.pg.Exec(`DELETE FROM mcp_servers WHERE name=$1`, name) }()
+	body, _ := json.Marshal(map[string]any{"name": name, "transport": "stdio", "command": "x", "enabled": false})
+	req := httptest.NewRequest(http.MethodPost, "/api/mcp", bytes.NewReader(body))
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("Content-Type", "application/json")
+	w := httptest.NewRecorder()
+	s.Handler().ServeHTTP(w, req)
+	if w.Code != http.StatusOK {
+		t.Fatalf("operator stdio create = %d: %s", w.Code, w.Body.String())
+	}
+	if row := mcpRowByName(t, m, name); row == nil || row.Transport != "stdio" {
+		t.Fatalf("operator stdio row = %+v", row)
+	}
+}
