+func TestTaskArchiveRestoreRejectsExtractionOutsideDataDir(t *testing.T) {
+	dataDir := t.TempDir()
+	outside := t.TempDir()
+	source := filepath.Join(outside, "files", "tasks", "42", "evidence.txt")
+	if err := os.MkdirAll(filepath.Dir(source), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(source, []byte("outside"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := installTaskArchiveFiles(dataDir, outside, "42", 1); err == nil {
+		t.Fatal("restore accepted an extraction directory outside the data dir")
+	}
+	if _, err := os.Stat(filepath.Join(dataDir, "tasks", "42", "evidence.txt")); !os.IsNotExist(err) {
+		t.Fatalf("outside extraction still produced a destination: %v", err)
+	}
+}
+
+func TestTaskArchiveRestoreRefusesSymlinkedDestination(t *testing.T) {
+	dataDir := t.TempDir()
+	outside := t.TempDir()
+	extracted := filepath.Join(dataDir, "archives", "tasks", ".restore", "f007-link")
+	source := filepath.Join(extracted, "files", "tasks", "42", "evidence.txt")
+	if err := os.MkdirAll(filepath.Dir(source), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(source, []byte("evidence"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(dataDir, "tasks")); err != nil {
+		t.Skipf("symlink unsupported: %v", err)
+	}
+	if _, err := installTaskArchiveFiles(dataDir, extracted, "42", 1); err == nil {
+		t.Fatal("restore followed a symlinked tasks parent")
+	}
+	if _, err := os.Stat(filepath.Join(outside, "42", "evidence.txt")); !os.IsNotExist(err) {
+		t.Fatalf("restore wrote through the symlink outside the data dir: %v", err)
+	}
+}
